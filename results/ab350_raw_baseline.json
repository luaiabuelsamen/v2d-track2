    "broken_run_2026-10-25": {
      "what": "The same recipe with scene.support hardcoded false, so the 14 clips that need a table were trained and evaluated without one. Superseded by the relaunch below; kept because it is the evidence for the bug, not a measurement of RAW.",
      "git_sha": "86594b7445f53a9827de37e0792f4b0168524b47",
      "verdict": "TRIPPED",
      "stop_lines": {
        "basis": "mean over the three clips, per docs/AB350_BAR.md",
